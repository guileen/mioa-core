    "backend": "pure JavaScript signal graph and DSP; software headless sink; 128-frame render quantum",
    "supportedSampleRatesHz": [
      8000,
      96000
    ],
    "unsupported": [
      "physical audio devices",
      "AudioWorklet",
      "media element/stream source and destination",
      "convolution",
      "3D panning/spatial listener",
      "compressed codecs other than WAV",
      "bit-identical Chrome/WebKit audio fingerprint output"
    ],
    "compressor": "local linked-channel soft-knee DSP replaces upstream passthrough; attack/release smoothing, no look-ahead/platform matching"
  },
  "worker": {
    "runtime": "existing deno_core 0.412.0 / V8 on its dedicated owning OS thread; one-worker multi-thread Tokio reactor; no page snapshot",
    "threadCost": "One additional persistent Tokio reactor worker thread per live dedicated Worker supports synchronous classic imports; V8 and Rc state never move to it. Existing DNS/blocking I/O pool costs remain transport-dependent.",
    "classicImports": "importScripts resolves arguments against the final Worker entry URL, loads sequentially through the existing native fetch/proxy/cookie/origin/SSRF/redirect/interception pipeline, validates status and JavaScript MIME, then compiles/runs on the original Worker isolate; termination cancels pending loading",
    "newRustDependencies": [],
    "sharedResources": [
      "host-owned schema3 resolved identity and native creator origin override page-supplied values",
      "native HTTP client and configured proxy",
      "cookie jar",
      "IndexedDB context store",
      "request callbacks/interception",
      "page in-flight counter"
    ],
    "messaging": "native structured serialization with IndexedDB Blob/File codecs, asynchronous native channels plus receiver task dispatch; termination interrupts the V8 isolate",
    "unsupported": [
      "module workers",
      "nested workers",
      "SharedWorker",
      "ServiceWorker",
      "transfer lists/MessagePort transfer",
      "SharedArrayBuffer and WebAssembly.Module transfer",
      "streaming Response.body and request bodies",
      "streaming TextDecoder",
      "WebSocket",
      "WebCrypto subtle",
      "unavailable architecture/bitness/model/platformVersion high-entropy values are reported empty",
      "URLSearchParams and FormData",
      "MessageChannel and BroadcastChannel",
      "Fetch cache modes other than default/no-store, referrer policy and non-follow redirect modes",
      "platform-object cloning beyond the shared Blob/File storage codecs",
      "complete WebIDL descriptor and brand conformance",
      "OffscreenCanvas and Worker Canvas/WebGL rendering (Window/iframe real rendering is unchanged)"
    ]
  },
  "build": {
    "additionalSystemDependencies": [],
    "additionalCargoFeatures": [],
    "existingOptionalFeature": "stealth preserves the existing native stealth HTTP transport; no render feature required for Audio/Worker",
